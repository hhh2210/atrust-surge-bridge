#!/bin/bash
set -euo pipefail

SCRIPT_PATH="$(realpath "$0")"
ROOT_DIR="$(unset CDPATH; cd -- "$(dirname -- "${SCRIPT_PATH}")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "${ROOT_DIR}/lib/common.sh"
# shellcheck source=../lib/surge_mode.sh
source "${ROOT_DIR}/lib/surge_mode.sh"
# shellcheck source=../lib/status.sh
source "${ROOT_DIR}/lib/status.sh"
# shellcheck source=../lib/ui.sh
source "${ROOT_DIR}/lib/ui.sh"

hitsz_ui_activate_and_settle() {
  local stable_seconds="${HITSZ_ROUTE_STABLE_SECONDS:-30}"
  local activate_step="${1:-2/3}" settle_step="${2:-3/3}"
  [[ "${stable_seconds}" =~ ^[0-9]+$ ]] || stable_seconds=30

  if ! hitsz_ui_run_action "${activate_step} VPN 已连；接入 Surge 并验证 JW…" \
      "${SCRIPT_PATH}" __core_activate; then
    hitsz_ui_warn_activation_failed "$(hitsz_current_selection)"
    hitsz_mode_status
    return 1
  fi
  hitsz_ui_mark_network_ready
  if [[ "${HITSZ_SETTLE_FOREGROUND:-0}" == "1" ]]; then
    if ! hitsz_ui_run_action \
        "${settle_step} 网络已通；验收 ${stable_seconds} 秒稳定性并回收浏览器…" \
        "${SCRIPT_PATH}" __core_settle; then
      hitsz_mode_status
      return 1
    fi
  elif hitsz_settle_dispatch >/dev/null; then
    hitsz_ui_note_background_settle "${stable_seconds}"
  else
    gum log --level warn '后台稳定性验收未能启动；可运行 HITSZ_SETTLE_FOREGROUND=1 hitsz up'
  fi
  hitsz_mode_status
}

action="${1:-}"
if [[ -z "${action}" ]]; then
  if hitsz_ui_enabled; then
    action="$(hitsz_ui_choose_action)" || exit 0
  else
    action="status"
  fi
fi

case "${action}" in
  __core_start)
    hitsz_mode_start
    ;;
  __core_up)
    hitsz_mode_up
    ;;
  __core_connect)
    hitsz_mode_connect
    ;;
  __core_activate)
    hitsz_mode_activate_route
    ;;
  __core_settle)
    hitsz_mode_settle
    ;;
  __core_settle_bg)
    hitsz_mode_settle_bg "${2:?missing settle generation}"
    ;;
  __core_finish)
    hitsz_mode_finish
    ;;
  __core_down)
    hitsz_mode_down
    ;;
  up | on | outside | external)
    if hitsz_ui_enabled; then
      ensure_env
      if ! hitsz_ui_run_action '1/3 启动隔离 aTrust 并恢复会话…' \
          "${SCRIPT_PATH}" __core_connect; then
        hitsz_ui_show_vnc_credential "$(vnc_password)"
        hitsz_mode_status
        exit 1
      fi
      hitsz_ui_activate_and_settle
    else
      hitsz_mode_up
      hitsz_mode_status
    fi
    ;;
  login | vnc)
    ensure_env
    hitsz_ui_show_vnc_credential "$(vnc_password)"
    hitsz_open_login
    if hitsz_ui_enabled && hitsz_ui_confirm_login; then
      hitsz_ui_activate_and_settle '1/2' '2/2'
    fi
    ;;
  down | off | inside | direct)
    if hitsz_ui_enabled; then
      hitsz_ui_run_action '正在关闭 Docker / Colima…' "${SCRIPT_PATH}" __core_down
      hitsz_mode_status
    else
      hitsz_mode_down
      hitsz_mode_status
    fi
    ;;
  status)
    hitsz_mode_status
    ;;
  *)
    printf 'usage: hitsz {up|login|down|status}\n' >&2
    printf '  up:   start isolated aTrust for use outside campus\n' >&2
    printf '  login: show the loopback noVNC credential and open the login UI\n' >&2
    printf '  down: stop Docker/Colima; Surge keeps campus DIRECT access\n' >&2
    exit 64
    ;;
esac
